{
  "/applications": {
    "get": {
      "tags": ["Applications"],
      "summary": "Get all adoption applications",
      "description": "Retrieve a standard array of all application documents from the database.",
      "responses": {
        "200": { "description": "A list of applications." },
        "500": { "description": "Database error." }
      }
    },
    "post": {
      "tags": ["Applications"],
      "summary": "Submit a new adoption application",
      "description": "Inserts a new application document into the MongoDB collection. Requires authentication.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["pet_id", "adopter_id", "shelter_id", "status", "submission_date"],
              "properties": {
                "pet_id": { "type": "string", "example": "66a27e7f1c9d4b001a000001", "pattern": "^[0-9a-fA-F]{24}$" },
                "adopter_id": { "type": "string", "example": "66a28faf1c9d4b001b000001", "pattern": "^[0-9a-fA-F]{24}$" },
                "shelter_id": { "type": "string", "example": "66a27e7f1c9d4b001a111111", "pattern": "^[0-9a-fA-F]{24}$" },
                "status": { "type": "string", "example": "approved", "enum": ["pending", "approved", "rejected"] },
                "submission_date": { "type": "string", "format": "date", "example": "2026-06-15" },
                "notes": { "type": "string", "example": "Adopter house check completed. Large fenced yard is perfect for Bella." }
              }
            }
          }
        }
      },
      "responses": {
        "201": { "description": "Application submitted successfully." },
        "400": { "description": "Missing required fields or invalid payload parameters." },
        "401": { "description": "Unauthorized. GitHub login required." },
        "500": { "description": "Database insertion failed." }
      }
    }
  },
  "/applications/{id}": {
    "get": {
      "tags": ["Applications"],
      "summary": "Get a single application by ID",
      "description": "Search the database for a matching unique application _id record.",
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": { "type": "string" },
          "description": "The unique 24-character MongoDB Object ID of the application",
          "example": "66a29abc1c9d4b001c000005"
        }
      ],
      "responses": {
        "200": { "description": "Application object found." },
        "404": { "description": "Application not found." },
        "500": { "description": "Invalid ID format or server error." }
      }
    },
    "put": {
      "tags": ["Applications"],
      "summary": "Update application record",
      "description": "Updates an application document in the MongoDB collection. Requires authentication.",
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": { "type": "string" },
          "description": "The unique 24-character MongoDB ObjectId of the application",
          "example": "66a29abc1c9d4b001c000005"
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["pet_id", "adopter_id", "shelter_id", "status", "submission_date"],
              "properties": {
                "pet_id": { "type": "string", "example": "66a27e7f1c9d4b001a000001", "pattern": "^[0-9a-fA-F]{24}$" },
                "adopter_id": { "type": "string", "example": "66a28faf1c9d4b001b000001", "pattern": "^[0-9a-fA-F]{24}$" },
                "shelter_id": { "type": "string", "example": "66a27e7f1c9d4b001a111111", "pattern": "^[0-9a-fA-F]{24}$" },
                "status": { "type": "string", "example": "approved", "enum": ["pending", "approved", "rejected"] },
                "submission_date": { "type": "string", "format": "date", "example": "2026-06-15" },
                "notes": { "type": "string", "example": "Adopter house check completed. Large fenced yard is perfect for Bella." }
              }
            }
          }
        }
      },
      "responses": {
        "200": { "description": "Application updated successfully." },
        "400": { "description": "Invalid ID format or missing required fields." },
        "401": { "description": "Unauthorized. GitHub login required." },
        "500": { "description": "Database update failed." }
      }
    },
    "delete": {
      "tags": ["Applications"],
      "summary": "Delete an application record by ID",
      "description": "Permanently deletes an application document from the MongoDB collection. Requires authentication.",
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": { "type": "string" },
          "description": "The unique 24-character MongoDB ObjectId of the application to delete",
          "example": "66a29abc1c9d4b001c000005"
        }
      ],
      "responses": {
        "200": { "description": "Application successfully deleted." },
        "400": { "description": "Invalid ID format." },
        "401": { "description": "Unauthorized. GitHub login required." },
        "404": { "description": "Application record not found." },
        "500": { "description": "Database deletion failed." }
      }
    }
  }
}
