{
    "/adopters": {
        "get": {
            "tags": [
                "Adopters"
            ],
            "summary": "Get all adopters",
            "description": "Retrieve all adopter records from the database.",
            "responses": {
                "200": {
                    "description": "A list of adopters."
                },
                "500": {
                    "description": "Database error."
                }
            }
        },
        "post": {
            "tags": [
                "Adopters"
            ],
            "summary": "Create a new adopter",
            "description": "Creates a new adopter record for signup.",
            "requestBody": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "required": [
                                "first_name",
                                "last_name",
                                "email",
                                "phone"
                            ],
                            "properties": {
                                "first_name": {
                                    "type": "string",
                                    "example": "Jane"
                                },
                                "last_name": {
                                    "type": "string",
                                    "example": "Doe"
                                },
                                "email": {
                                    "type": "string",
                                    "format": "email",
                                    "example": "jane.doe@example.com"
                                },
                                "phone": {
                                    "type": "string",
                                    "example": "555-0123"
                                },
                                "location": {
                                    "type": "string",
                                    "example": "Springfield"
                                },
                                "preferences": {
                                    "type": "string",
                                    "example": "Medium dog, good with kids"
                                },
                                "household_info": {
                                    "type": "string",
                                    "example": "2 adults, fenced yard"
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "201": {
                    "description": "Adopter created successfully."
                },
                "400": {
                    "description": "Missing required fields or invalid payload."
                },
                "500": {
                    "description": "Database insertion failed."
                }
            }
        }
    },
    "/adopters/{id}": {
        "get": {
            "tags": [
                "Adopters"
            ],
            "summary": "Get an adopter by ID",
            "description": "Retrieve a single adopter record by its MongoDB ObjectId.",
            "parameters": [
                {
                    "in": "path",
                    "name": "id",
                    "required": true,
                    "schema": {
                        "type": "string"
                    },
                    "description": "The adopter's MongoDB ObjectId"
                }
            ],
            "responses": {
                "200": {
                    "description": "Adopter record found."
                },
                "404": {
                    "description": "Adopter not found."
                },
                "500": {
                    "description": "Database error."
                }
            }
        },
        "put": {
            "tags": [
                "Adopters"
            ],
            "summary": "Update an adopter",
            "description": "Updates an adopter record. Requires authentication.",
            "security": [
                {
                    "GoogleOAuth": [
                        "profile",
                        "email"
                    ]
                }
            ],
            "parameters": [
                {
                    "in": "path",
                    "name": "id",
                    "required": true,
                    "schema": {
                        "type": "string"
                    },
                    "description": "The adopter's MongoDB ObjectId"
                }
            ],
            "requestBody": {
                "required": true,
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "first_name": {
                                    "type": "string"
                                },
                                "last_name": {
                                    "type": "string"
                                },
                                "email": {
                                    "type": "string",
                                    "format": "email"
                                },
                                "phone": {
                                    "type": "string"
                                },
                                "location": {
                                    "type": "string"
                                },
                                "preferences": {
                                    "type": "string"
                                },
                                "household_info": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Adopter updated successfully."
                },
                "400": {
                    "description": "Invalid input or missing fields."
                },
                "401": {
                    "description": "Unauthorized. Google login required."
                },
                "404": {
                    "description": "Adopter not found."
                },
                "500": {
                    "description": "Database update failed."
                }
            }
        },
        "delete": {
            "tags": [
                "Adopters"
            ],
            "summary": "Delete an adopter",
            "description": "Deletes an adopter record. Requires authentication.",
            "security": [
                {
                    "GoogleOAuth": [
                        "profile",
                        "email"
                    ]
                }
            ],
            "parameters": [
                {
                    "in": "path",
                    "name": "id",
                    "required": true,
                    "schema": {
                        "type": "string"
                    },
                    "description": "The adopter's MongoDB ObjectId"
                }
            ],
            "responses": {
                "200": {
                    "description": "Adopter deleted successfully."
                },
                "400": {
                    "description": "Invalid ID format."
                },
                "401": {
                    "description": "Unauthorized. Google login required."
                },
                "404": {
                    "description": "Adopter not found."
                },
                "500": {
                    "description": "Database deletion failed."
                }
            }
        }
    }
}