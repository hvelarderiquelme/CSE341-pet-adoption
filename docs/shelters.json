{
  "/shelters": {
    "get": {
      "tags": ["Shelters"],
      "summary": "Get all shelters",
      "responses": {
        "200": {
          "description": "List of shelters"
        }
      }
    },
    "post": {
      "tags": ["Shelters"],
      "summary": "Create a shelter",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "name",
                "address",
                "city",
                "state",
                "zipCode",
                "phone",
                "email",
                "capacity",
                "currentAnimals",
                "acceptingAnimals"
              ],
              "properties": {
                "name": { "type": "string" },
                "address": { "type": "string" },
                "city": { "type": "string" },
                "state": { "type": "string" },
                "zipCode": { "type": "string" },
                "phone": { "type": "string" },
                "email": { "type": "string" },
                "capacity": { "type": "integer" },
                "currentAnimals": { "type": "integer" },
                "acceptingAnimals": { "type": "string" }
              }
            }
          }
        }
      },
      "responses": {
        "201": { "description": "Shelter created" },
        "400": { "description": "Validation failed" }
      }
    }
  },
  "/shelters/{id}": {
    "get": {
      "tags": ["Shelters"],
      "summary": "Get one shelter by ID",
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "responses": {
        "200": { "description": "Shelter found" },
        "404": { "description": "Shelter not found" }
      }
    },
    "put": {
      "tags": ["Shelters"],
      "summary": "Update a shelter",
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "responses": {
        "204": { "description": "Shelter updated" },
        "400": { "description": "Validation failed" },
        "404": { "description": "Shelter not found" }
      }
    },
    "delete": {
      "tags": ["Shelters"],
      "summary": "Delete a shelter",
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "responses": {
        "204": { "description": "Shelter deleted" },
        "404": { "description": "Shelter not found" }
      }
    }
  }
}