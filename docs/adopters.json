    "delete": {
      "tags": ["Adopters"],
      "summary": "Delete an adopter record by ID",
      "description": "Permanently deletes an adopter document from the MongoDB collection. Requires authentication.",
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The unique 24-character MongoDB ObjectId of the adopter to delete",
          "example": "6a64f155606e759639e960ab"
        }
      ],
      "responses": {
        "200": {
          "description": "Adopter successfully deleted."
        },
        "400": {
          "description": "Invalid ID format."
        },
        "401": {
          "description": "Unauthorized. GitHub login required."
        },
        "404": {
          "description": "Adopter record not found."
        },
        "500": {
          "description": "Database deletion failed."
        }
      }
    }
  }
}
