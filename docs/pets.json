{
  "/pets": {
    "get": {
      "tags": ["Pets"],
      "summary": "Get all pets",
      "description": "Retrieve a standard array of all pet documents from the database.",
      "responses": {
        "200": { "description": "A list of pets." },
        "500": { "description": "Database error." }
      }
    },
    "post": {
      "tags": ["Pets"],
      "summary": "Create a new pet record",
      "description": "Inserts a new pet document into the MongoDB collection. Requires authentication.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["name", "species", "breed", "age", "gender", "size", "status", "shelter_id", "intake_date"],
              "properties": {
                "name": { "type": "string", "example": "Bella" },
                "species": { "type": "string", "example": "Dog" },
                "breed": { "type": "string", "example": "Labrador Retriever" },
                "age": { "type": "integer", "example": 3 },
                "gender": { "type": "string", "example": "Female" },
                "size": { "type": "string", "example": "Large" },
                "status": { "type": "string", "example": "available", "enum": ["available", "adopted", "pending"] },
                "shelter_id": { "type": "string", "example": "66a27e7f1c9d4b001a111111", "pattern": "^[0-9a-fA-F]{24}$" },
                "description": { "type": "string", "example": "Sweet, energetic, and loves playing fetch. Great with kids!" },
                "traits": { 
                  "type": "array", 
                  "items": { "type": "string" }, 
                  "example": ["Friendly", "Active", "House-trained"] 
                },
                "intake_date": { "type": "string", "format": "date", "example": "2026-05-12" }
              }
            }
          }
        }
      },
      "responses": {
        "201": { "description": "Pet record created successfully." },
        "400": { "description": "Missing required fields or invalid payload parameters." },
        "401": { "description": "Unauthorized. GitHub login required." },
        "500": { "description": "Database insertion failed." }
      }
    }
  },
  "/pets/{id}": {
    "get": {
      "tags": ["Pets"],
      "summary": "Get a single pet by ID",
      "description": "Search the database for a matching unique pet _id record.",
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": { "type": "string" },
          "description": "The unique 24-character MongoDB Object ID of the pet",
          "example": "66a27e7f1c9d4b001a000001"
        }
      ],
      "responses": {
        "200": { "description": "Pet object found." },
        "404": { "description": "Pet not found." },
        "500": { "description": "Invalid ID format or server error." }
      }
    },
    "put": {
      "tags": ["Pets"],
      "summary": "Update pet record",
      "description": "Updates a pet document in the MongoDB collection. Requires authentication.",
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": { "type": "string" },
          "description": "The unique 24-character MongoDB ObjectId of the pet",
          "example": "66a27e7f1c9d4b001a000001"
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["name", "species", "breed", "age", "gender", "size", "status", "shelter_id", "intake_date"],
              "properties": {
                "name": { "type": "string", "example": "Bella" },
                "species": { "type": "string", "example": "Dog" },
                "breed": { "type": "string", "example": "Labrador Retriever" },
                "age": { "type": "integer", "example": 3 },
                "gender": { "type": "string", "example": "Female" },
                "size": { "type": "string", "example": "Large" },
                "status": { "type": "string", "example": "available", "enum": ["available", "adopted", "pending"] },
                "shelter_id": { "type": "string", "example": "66a27e7f1c9d4b001a111111", "pattern": "^[0-9a-fA-F]{24}$" },
                "description": { "type": "string", "example": "Sweet, energetic, and loves playing fetch. Great with kids!" },
                "traits": { 
                  "type": "array", 
                  "items": { "type": "string" }, 
                  "example": ["Friendly", "Active", "House-trained"] 
                },
                "intake_date": { "type": "string", "format": "date", "example": "2026-05-12" }
              }
            }
          }
        }
      },
      "responses": {
        "200": { "description": "Pet updated successfully." },
        "400": { "description": "Invalid ID format or missing required fields." },
        "401": { "description": "Unauthorized. GitHub login required." },
        "500": { "description": "Database update failed." }
      }
    },
    "delete": {
      "tags": ["Pets"],
      "summary": "Delete a pet record by ID",
      "description": "Permanently deletes a pet document from the MongoDB collection. Requires authentication.",
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": { "type": "string" },
          "description": "The unique 24-character MongoDB ObjectId of the pet to delete",
          "example": "66a27e7f1c9d4b001a000001"
        }
      ],
      "responses": {
        "200": { "description": "Pet successfully deleted." },
        "400": { "description": "Invalid ID format." },
        "401": { "description": "Unauthorized. GitHub login required." },
        "404": { "description": "Pet record not found." },
        "500": { "description": "Database deletion failed." }
      }
    }
  }
}
